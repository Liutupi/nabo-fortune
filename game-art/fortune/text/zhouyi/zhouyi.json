[
 {
  "kw": 1,
  "up": 0,
  "lo": 0,
  "name": "乾",
  "gua": "元亨利贞。",
  "lines": [
   {
    "pos": "初九",
    "text": "潜龙勿用。"
   },
   {
    "pos": "九二",
    "text": "见龙在田，利见大人。"
   },
   {
    "pos": "九三",
    "text": "君子终日乾乾，夕惕若；厉，无咎。"
   },
   {
    "pos": "九四",
    "text": "或跃在渊，无咎。"
   },
   {
    "pos": "九五",
    "text": "飞龙在天，利见大人。"
   },
   {
    "pos": "上九",
    "text": "亢龙有悔。"
   }
  ],
  "special": {
   "pos": "用九",
   "text": "见群龙无首，吉。"
  },
  "bh": "自强不息，时机正好，大胆去做，但别骄傲。"
 },
 {
  "kw": 2,
  "up": 7,
  "lo": 7,
  "name": "坤",
  "gua": "元亨，利牝马之贞。君子有攸往，先迷后得主。利西南得朋，东北丧朋。安贞吉。",
  "lines": [
   {
    "pos": "初六",
    "text": "履霜，坚冰至。"
   },
   {
    "pos": "六二",
    "text": "直方大，不习，无不利。"
   },
   {
    "pos": "六三",
    "text": "含章可贞。或从王事，无成有终。"
   },
   {
    "pos": "六四",
    "text": "括囊，无咎无誉。"
   },
   {
    "pos": "六五",
    "text": "黄裳，元吉。"
   },
   {
    "pos": "上六",
    "text": "龙战于野，其血玄黄。"
   }
  ],
  "special": {
   "pos": "用六",
   "text": "利永贞。"
  },
  "bh": "厚德载物，顺势而为，做好配合就会有收获。"
 },
 {
  "kw": 3,
  "up": 5,
  "lo": 3,
  "name": "屯",
  "gua": "元亨利贞。勿用有攸往，利建侯。",
  "lines": [
   {
    "pos": "初九",
    "text": "磐桓，利居贞，利建侯。"
   },
   {
    "pos": "六二",
    "text": "屯如邅如，乘马班如。匪寇婚媾，女子贞不字，十年乃字。"
   },
   {
    "pos": "六三",
    "text": "即鹿无虞，惟入于林中。君子几，不如舍。往吝。"
   },
   {
    "pos": "六四",
    "text": "乘马班如，求婚媾，往吉，无不利。"
   },
   {
    "pos": "九五",
    "text": "屯其膏，小贞吉，大贞凶。"
   },
   {
    "pos": "上六",
    "text": "乘马班如，泣血涟如。"
   }
  ],
  "special": null,
  "bh": "万事开头难，先打好基础，别急着冒进。"
 },
 {
  "kw": 4,
  "up": 6,
  "lo": 5,
  "name": "蒙",
  "gua": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
  "lines": [
   {
    "pos": "初六",
    "text": "发蒙，利用刑人，用说桎梏。以往，吝。"
   },
   {
    "pos": "九二",
    "text": "包蒙，吉。纳妇吉。子克家。"
   },
   {
    "pos": "六三",
    "text": "勿用取女，见金夫，不有躬。无攸利。"
   },
   {
    "pos": "六四",
    "text": "困蒙，吝。"
   },
   {
    "pos": "六五",
    "text": "童蒙，吉。"
   },
   {
    "pos": "上九",
    "text": "击蒙。不利为寇，利御寇。"
   }
  ],
  "special": null,
  "bh": "还在摸索阶段，虚心求教，找对老师最重要。"
 },
 {
  "kw": 5,
  "up": 5,
  "lo": 0,
  "name": "需",
  "gua": "有孚，光亨，贞吉。利涉大川。",
  "lines": [
   {
    "pos": "初九",
    "text": "需于郊，利用恒，无咎。"
   },
   {
    "pos": "九二",
    "text": "需于沙，小有言，终吉。"
   },
   {
    "pos": "九三",
    "text": "需于泥，致寇至。"
   },
   {
    "pos": "六四",
    "text": "需于血，出自穴。"
   },
   {
    "pos": "九五",
    "text": "需于酒食，贞吉。"
   },
   {
    "pos": "上六",
    "text": "入于穴，有不速之客三人来，敬之终吉。"
   }
  ],
  "special": null,
  "bh": "时机未到，耐心等待，养精蓄锐。"
 },
 {
  "kw": 6,
  "up": 0,
  "lo": 5,
  "name": "讼",
  "gua": "有孚，窒惕，中吉，终凶。利见大人，不利涉大川。",
  "lines": [
   {
    "pos": "初六",
    "text": "不永所事，小有言，终吉。"
   },
   {
    "pos": "九二",
    "text": "不克讼，归而逋，其邑人三百户无眚。"
   },
   {
    "pos": "六三",
    "text": "食旧德，贞厉，终吉。或从王事，无成。"
   },
   {
    "pos": "九四",
    "text": "不克讼，复即命，渝安贞，吉。"
   },
   {
    "pos": "九五",
    "text": "讼，元吉。"
   },
   {
    "pos": "上九",
    "text": "或锡之鞶带，终朝三褫之。"
   }
  ],
  "special": null,
  "bh": "容易起争执，退一步海阔天空，别把事闹大。"
 },
 {
  "kw": 7,
  "up": 7,
  "lo": 5,
  "name": "师",
  "gua": "贞，丈人吉，无咎。",
  "lines": [
   {
    "pos": "初六",
    "text": "师出以律，否臧，凶。"
   },
   {
    "pos": "九二",
    "text": "在师中，吉无咎，王三锡命。"
   },
   {
    "pos": "六三",
    "text": "师或舆尸，凶。"
   },
   {
    "pos": "六四",
    "text": "师左次，无咎。"
   },
   {
    "pos": "六五",
    "text": "田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。"
   },
   {
    "pos": "上六",
    "text": "大君有命，开国承家，小人勿用。"
   }
  ],
  "special": null,
  "bh": "需要组织和纪律，找对带头的人，齐心可成事。"
 },
 {
  "kw": 8,
  "up": 5,
  "lo": 7,
  "name": "比",
  "gua": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
  "lines": [
   {
    "pos": "初六",
    "text": "有孚，比之，无咎。有孚盈缶，终来有它吉。"
   },
   {
    "pos": "六二",
    "text": "比之自内，贞吉。"
   },
   {
    "pos": "六三",
    "text": "比之匪人。"
   },
   {
    "pos": "六四",
    "text": "外比之，贞吉。"
   },
   {
    "pos": "九五",
    "text": "显比，王用三驱，失前禽。邑人不诫，吉。"
   },
   {
    "pos": "上六",
    "text": "比之无首，凶。"
   }
  ],
  "special": null,
  "bh": "亲近值得信任的人，抱团合作，越早越好。"
 },
 {
  "kw": 9,
  "up": 4,
  "lo": 0,
  "name": "小畜",
  "gua": "亨。密云不雨，自我西郊。",
  "lines": [
   {
    "pos": "初九",
    "text": "复自道，何其咎?吉。"
   },
   {
    "pos": "九二",
    "text": "牵复，吉。"
   },
   {
    "pos": "九三",
    "text": "舆说辐，夫妻反目。"
   },
   {
    "pos": "六四",
    "text": "有孚，血去惕出，无咎。"
   },
   {
    "pos": "九五",
    "text": "有孚挛如，富以其邻。"
   },
   {
    "pos": "上九",
    "text": "既雨既处，尚德载。妇贞厉。月几望，君子征凶。"
   }
  ],
  "special": null,
  "bh": "力量还在积蓄，小有收获，大事再等等。"
 },
 {
  "kw": 10,
  "up": 0,
  "lo": 1,
  "name": "履",
  "gua": "履虎尾，不咥人，亨。",
  "lines": [
   {
    "pos": "初九",
    "text": "素履，往无咎。"
   },
   {
    "pos": "九二",
    "text": "履道坦坦，幽人贞吉。"
   },
   {
    "pos": "六三",
    "text": "眇能视，跛能履。履虎尾，咥人，凶。武人为于大君。"
   },
   {
    "pos": "九四",
    "text": "履虎尾，愬愬，终吉。"
   },
   {
    "pos": "九五",
    "text": "夬履，贞厉。"
   },
   {
    "pos": "上九",
    "text": "视履考祥，其旋元吉。"
   }
  ],
  "special": null,
  "bh": "如履薄冰，按规矩办事，小心谨慎就能平安。"
 },
 {
  "kw": 11,
  "up": 7,
  "lo": 0,
  "name": "泰",
  "gua": "小往大来，吉亨。",
  "lines": [
   {
    "pos": "初九",
    "text": "拔茅，茹以其汇，征吉。"
   },
   {
    "pos": "九二",
    "text": "包荒，用冯河，不遐遗，朋亡，得尚于中行。"
   },
   {
    "pos": "九三",
    "text": "无平不陂，无往不复。艰贞无咎。勿恤其孚，于食有福。"
   },
   {
    "pos": "六四",
    "text": "翩翩不富以其邻，不戒以孚。"
   },
   {
    "pos": "六五",
    "text": "帝乙归妹，以祉元吉。"
   },
   {
    "pos": "上六",
    "text": "城复于隍，勿用师。自邑告命，贞吝。"
   }
  ],
  "special": null,
  "bh": "天地交泰，上下通顺，正是好时候。"
 },
 {
  "kw": 12,
  "up": 0,
  "lo": 7,
  "name": "否",
  "gua": "否之匪人。不利君子贞。大往小来。",
  "lines": [
   {
    "pos": "初六",
    "text": "拔茅，茹以其汇，贞吉，亨。"
   },
   {
    "pos": "六二",
    "text": "包承，小人吉；大人否，亨。"
   },
   {
    "pos": "六三",
    "text": "包羞。"
   },
   {
    "pos": "九四",
    "text": "有命无咎，畴离祉。"
   },
   {
    "pos": "九五",
    "text": "休否，大人吉；其亡其亡，系于苞桑。"
   },
   {
    "pos": "上九",
    "text": "倾否，先否后喜。"
   }
  ],
  "special": null,
  "bh": "上下不通，暂时闭塞，守住本心，等待转机。"
 },
 {
  "kw": 13,
  "up": 0,
  "lo": 2,
  "name": "同人",
  "gua": "同人于野，亨。利涉大川，利君子贞。",
  "lines": [
   {
    "pos": "初九",
    "text": "同人于门，无咎。"
   },
   {
    "pos": "六二",
    "text": "同人于宗，吝。"
   },
   {
    "pos": "九三",
    "text": "伏戎于莽，升其高陵，三岁不兴。"
   },
   {
    "pos": "九四",
    "text": "乘其墉，弗克攻，吉。"
   },
   {
    "pos": "九五",
    "text": "同人，先号啕而后笑，大师克相遇。"
   },
   {
    "pos": "上九",
    "text": "同人于郊，无悔。"
   }
  ],
  "special": null,
  "bh": "和志同道合的人一起干，公开透明最有利。"
 },
 {
  "kw": 14,
  "up": 2,
  "lo": 0,
  "name": "大有",
  "gua": "元亨。",
  "lines": [
   {
    "pos": "初九",
    "text": "无交害，匪咎；艰则无咎。"
   },
   {
    "pos": "九二",
    "text": "大车以载，有攸往，无咎。"
   },
   {
    "pos": "九三",
    "text": "公用，亨于天子，小人弗克。"
   },
   {
    "pos": "九四",
    "text": "匪其彭，无咎。"
   },
   {
    "pos": "六五",
    "text": "厥孚交如，威如，吉。"
   },
   {
    "pos": "上九",
    "text": "自天祐之，吉无不利。"
   }
  ],
  "special": null,
  "bh": "收获丰盛，保持谦虚，福气才能长久。"
 },
 {
  "kw": 15,
  "up": 7,
  "lo": 6,
  "name": "谦",
  "gua": "亨，君子有终。",
  "lines": [
   {
    "pos": "初六",
    "text": "谦谦君子，用涉大川，吉。"
   },
   {
    "pos": "六二",
    "text": "鸣谦，贞吉。"
   },
   {
    "pos": "九三",
    "text": "劳谦，君子有终，吉。"
   },
   {
    "pos": "六四",
    "text": "无不利，㧑谦。"
   },
   {
    "pos": "六五",
    "text": "不富以其邻，利用侵伐，无不利。"
   },
   {
    "pos": "上六",
    "text": "鸣谦，利用行师，征邑国。"
   }
  ],
  "special": null,
  "bh": "谦虚的人走到哪里都受欢迎，低调做事反而顺利。"
 },
 {
  "kw": 16,
  "up": 3,
  "lo": 7,
  "name": "豫",
  "gua": "利建侯行师。",
  "lines": [
   {
    "pos": "初六",
    "text": "鸣豫，凶。"
   },
   {
    "pos": "六二",
    "text": "介于石，不终日，贞吉。"
   },
   {
    "pos": "六三",
    "text": "盱豫，悔。 迟有悔。"
   },
   {
    "pos": "九四",
    "text": "由豫，大有得，勿疑，朋盍簪。"
   },
   {
    "pos": "六五",
    "text": "贞疾，恒不死。"
   },
   {
    "pos": "上六",
    "text": "冥豫，成有渝，无咎。"
   }
  ],
  "special": null,
  "bh": "心情愉快，适合筹备和行动，但别乐过头。"
 },
 {
  "kw": 17,
  "up": 1,
  "lo": 3,
  "name": "随",
  "gua": "元亨，利贞，无咎。",
  "lines": [
   {
    "pos": "初九",
    "text": "官有渝，贞吉。 出门交有功。"
   },
   {
    "pos": "六二",
    "text": "系小子，失丈夫。"
   },
   {
    "pos": "六三",
    "text": "系丈夫，失小子。随有求，得，利居贞。"
   },
   {
    "pos": "九四",
    "text": "随有获，贞凶。有孚，在道以明，何咎?"
   },
   {
    "pos": "九五",
    "text": "孚于嘉，吉。"
   },
   {
    "pos": "上六",
    "text": "拘系之，乃从维之；王用亨于西山。"
   }
  ],
  "special": null,
  "bh": "顺应形势、跟随正道，灵活调整就会顺利。"
 },
 {
  "kw": 18,
  "up": 6,
  "lo": 4,
  "name": "蛊",
  "gua": "元亨，利涉大川。先甲三日，后甲三日。",
  "lines": [
   {
    "pos": "初六",
    "text": "干父之蛊，有子，考无咎。厉，终吉。"
   },
   {
    "pos": "九二",
    "text": "干母之蛊，不可贞。"
   },
   {
    "pos": "九三",
    "text": "干父之蛊，小有悔，无大咎。"
   },
   {
    "pos": "六四",
    "text": "裕父之蛊，往见吝。"
   },
   {
    "pos": "六五",
    "text": "干父之蛊，用誉。"
   },
   {
    "pos": "上九",
    "text": "不事王侯，高尚其事。"
   }
  ],
  "special": null,
  "bh": "积弊需要整顿，下决心改掉旧问题，就有新局面。"
 },
 {
  "kw": 19,
  "up": 7,
  "lo": 1,
  "name": "临",
  "gua": "元亨利贞。至于八月有凶。",
  "lines": [
   {
    "pos": "初九",
    "text": "咸临，贞吉。"
   },
   {
    "pos": "九二",
    "text": "咸临，吉，无不利。"
   },
   {
    "pos": "六三",
    "text": "甘临，无攸利。既忧之，无咎。"
   },
   {
    "pos": "六四",
    "text": "至临，无咎。"
   },
   {
    "pos": "六五",
    "text": "知临，大君之宜，吉。"
   },
   {
    "pos": "上六",
    "text": "敦临，吉，无咎。"
   }
  ],
  "special": null,
  "bh": "好运逐渐靠近，主动关心身边的人，事情会推进。"
 },
 {
  "kw": 20,
  "up": 4,
  "lo": 7,
  "name": "观",
  "gua": "盥而不荐，有孚颙若。",
  "lines": [
   {
    "pos": "初六",
    "text": "童观，小人无咎，君子吝。"
   },
   {
    "pos": "六二",
    "text": "窥观，利女贞。"
   },
   {
    "pos": "六三",
    "text": "观我生，进退。"
   },
   {
    "pos": "六四",
    "text": "观国之光，利用宾于王。"
   },
   {
    "pos": "九五",
    "text": "观我生，君子无咎。"
   },
   {
    "pos": "上九",
    "text": "观其生，君子无咎。"
   }
  ],
  "special": null,
  "bh": "先观察、再行动，看清局面比急着出手重要。"
 },
 {
  "kw": 21,
  "up": 2,
  "lo": 3,
  "name": "噬嗑",
  "gua": "亨。利用狱。",
  "lines": [
   {
    "pos": "初九",
    "text": "屦校灭趾，无咎。"
   },
   {
    "pos": "六二",
    "text": "噬肤灭鼻，无咎。"
   },
   {
    "pos": "六三",
    "text": "噬腊肉，遇毒。小吝，无咎。"
   },
   {
    "pos": "九四",
    "text": "噬乾胏，得金矢。利艰贞，吉。"
   },
   {
    "pos": "六五",
    "text": "噬乾肉，得黄金。贞厉，无咎。"
   },
   {
    "pos": "上九",
    "text": "何校灭耳，凶。"
   }
  ],
  "special": null,
